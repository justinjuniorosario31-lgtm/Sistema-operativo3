---PARTE 2---: FIREWALL-CMD
 ------------------ BLOQUEAR ---------------------------
sudo firewall-cmd --permanent --remove-service=http
sudo firewall-cmd --permanent --remove-port=80/tcp
sudo firewall-cmd --permanent --remove-port=22/tcp
sudo firewall-cmd --reload
sudo systemctl restart httpd
sudo systemctl restart sshd

VERIFICAR QUE EL ACCESO ESTA BLOQUEADO
curl http://10.0.0.60 : deberá decir que el puerto 80 esta bloqueado
ssh carlos@10.0.0.60: deberá decir que el tiempo de espera se agoto


--------------- DESBLOQUEAR ----------------------
sudo firewall-cmd --permanent --add-service=http
sudo firewall-cmd --permanent --add-port=80/tcp
sudo firewall-cmd --permanent --add-port=22/tcp
sudo firewall-cmd --reload
sudo systemctl restart httpd
sudo systemctl restart sshd

VERIFICAR QUE EL ACCESO ESTA DESBLOQUEADO
curl http://10.0.0.60: HOLA MUNDO
ssh carlos@10.0.0.60: deberá de acceder normalmente

