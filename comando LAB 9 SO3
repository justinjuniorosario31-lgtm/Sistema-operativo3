***************************************************************VIDEO 2 Desplieque de una VM con terraform en digital Ocean*************************************************
Comandos usados practica 2 Despliegue de una VM con terraform en digital Ocean
# Instala las utilidades base necesarias para gestionar repositorios con DNF
sudo dnf install -y dnf-plugins-core

# Añade el repositorio oficial de HashiCorp a tu sistema
sudo dnf config-manager addrepo --from-repofile=https://rpm.releases.hashicorp.com/fedora/hashicorp.repo

# Instala Terraform
sudo dnf -y install terraform

# Abre nano para crear el archivo de configuración principal de Terraform
sudo nano main.tf
terraform {
  required_providers {
    digitalocean = {
      source  = "digitalocean/digitalocean"
      version = "~> 2.0"
    }
  }
}


# Set the variable value in *.tfvars file
# or using -var="do_token=..." CLI option
variable "do_token" {}

# Configure the DigitalOcean Provider
provider "digitalocean" {
  token = "dop_v1_8f7441486f9b91e832f3f515b89767d5cc9e8d8f1a6"
}

# Create a web server
resource "digitalocean_droplet" "web" {
  image= ubuntu-22-04-x64
name = "OS3vm"
region = "nyc1"
size = "s-1vcpu-1gb"
ssh_keys = ["c3:f0:20:c0:a3:99:cb:2c:21:c0:bb:ab:c7:1c:5a:98"]
}

# Inicializa el directorio de Terraform (descarga el proveedor de DigitalOcean)
terraform init

# Muestra el plan de ejecución, indicando qué recursos se crearán sin aplicarlos aún
terraform plan

# Aplica los cambios y despliega la infraestructura en DigitalOcean
terraform apply

