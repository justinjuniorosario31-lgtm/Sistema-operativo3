========================================================practica 3  Cluster de Alta Disponibilidad HTTP =========================================================

sudo dnf install httpd* keepalived*-y   //en los 2 


mkdir -p /var/www/server1/html

nano /var/www/server1/html/index.html


<html>
<head><title>Hola</title></head>
<body>
<h1>Servidor 1</h1>
</body>
</html>


nano /etc/httpd/conf.d/server1.conf

<VirtualHost *:80>
    DocumentRoot "/var/www/server1/html"
    ServerName localhost
</VirtualHost>

sudo systemctl enable httpd
sudo systemctl start httpd
sudo systemctl status httpd

nano /etc/httpd/conf/httpd.conf
systemctl restart httpd

 =================ahora ponenos el keepalived==============

nano /etc/keepalived/keepalived.conf 

vrrp_instance VI_1 {
    state MASTER
    interface enp0s3
    virtual_router_id 51
    priority 100
    advert_int 1

    authentication {
        auth_type PASS
        auth_pass 1234
    }

    virtual_ipaddress {
        10.0.0.100/24
    }
}


systemctl enable keepalived.service
systemctl restart keepalived
setenforce 0


sudo firewall-cmd --permanent --add-port=80/tcp --zone=public
sudo firewall-cmd --permanent --add-service=http --zone=public
sudo firewall-cmd --permanent --add-service=https --zone=public
sudo firewall-cmd --permanent --add-protocol=vrrp --zone=public
sudo firewall-cmd --reload


